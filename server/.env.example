APP_PORT=8793
APP_HOST=0.0.0.0
APP_ENV=development
APP_SECRET=replace-with-a-random-secret

DB_MONGO_CONNECTION=mongodb://localhost:27017/webapp-template
DB_MONGO_USERNAME=replace-with-database-user
DB_MONGO_PASSWORD=replace-with-database-password

MIGRATE_ON_START=false

LOG_LEVEL=info
DEBUG=false

AUTH_MODE=oidc
APP_PUBLIC_ORIGIN=https://app.example.com
OIDC_ISSUER=https://auth.evanpatchouli.space
OIDC_CLIENT_ID=replace-with-independent-client-id
OIDC_CLIENT_SECRET=replace-with-client-secret
OIDC_TOKEN_AUTH_METHOD=client_secret_basic
OIDC_REDIRECT_URI=https://app.example.com/api/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=https://app.example.com/api/auth/logout/callback
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_ENCRYPTION_KEY=replace-with-32-byte-base64-key
SESSION_IDLE_TTL=1800
SESSION_ABSOLUTE_TTL=28800
TRUST_PROXY=loopback
